# Operator login. Required.
GROWTH_OPERATOR_PASSWORD=

# Optional. If empty, a key is created in apps/growth/data/secret.key
GROWTH_SESSION_SECRET=
GROWTH_SECRETS_KEY=

# 127.0.0.1 opens only on this computer. Use 0.0.0.0 so other computers on the network can open the console.
GROWTH_HOST=127.0.0.1
GROWTH_PORT=4180
# Address people type in the browser, and the OAuth redirect. Example for other computers: http://192.168.1.20:4180
GROWTH_PUBLIC_BASE=http://127.0.0.1:4180
# Name of the first operator created from GROWTH_OPERATOR_PASSWORD. Later operators are added in the מפעילים tab.
GROWTH_OPERATOR_NAME=מפעיל
GROWTH_SITE_ORIGIN=https://reelmino.com

# Optional producer. A Reelmino studio_session cookie, not a customer account inside this tool.
# The מגמות loop also uses this session to create one short per interval.
REELMINO_SESSION=
REELMINO_API=https://reelmino.com/api

# Brand account apps. No ad spend.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Leave unset until TikTok approves direct post. Until then uploads land in the inbox.
TIKTOK_DIRECT_POST=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_VERSION=202510

# Newsletter for this tool, separate from customer mail.
GROWTH_RESEND_API_KEY=
GROWTH_MAIL_FROM=
GROWTH_MAIL_TO=

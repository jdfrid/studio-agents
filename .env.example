# --- Core infra ---
DATABASE_URL=postgresql://studio:studio@localhost:5433/studio_agents?schema=public
REDIS_URL=redis://localhost:6380
# Render sets PORT automatically; API_PORT is for local dev only
PORT=4000
API_PORT=4000
WEB_PORT=5173
LOG_LEVEL=info

# --- Web (production / Render static site) ---
# Leave empty locally (Vite proxies /api). On Render, set to API RENDER_EXTERNAL_URL.
VITE_API_BASE_URL=

# --- Secret encryption (32 bytes base64) ---
SECRETS_KEY_BASE64=replace_with_32_random_bytes_base64

# --- Google Cloud Storage ---
GCS_BUCKET=studio-agents-dev
# Path to service-account JSON OR raw JSON in GCS_CREDENTIALS_JSON
GOOGLE_APPLICATION_CREDENTIALS=
GCS_CREDENTIALS_JSON=
GCS_SIGNED_URL_TTL_SECONDS=3600

# --- Provider keys (optional; can also live in DB ProviderCredential) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_LYRIA_ENABLED=1
GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# Preview video default. Uses POST /v1beta/interactions; unavailable/unsupported
# access falls back to veo-3.1-fast-generate-preview.
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash-preview
RENDER_PROFILE=omni-multiclip
XAI_API_KEY=
# Optional: Instant Voice Cloning for custom narration (upload sample on create-video form)
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_BASE_URL=https://api.shotstack.io/edit/v1
FAL_API_KEY=
HEYGEN_API_KEY=
LEMONSQUEEZY_API_KEY=

# --- Private mobile admin ---
# Must match the Android manifest; only this custom scheme is accepted by the API.
MOBILE_ADMIN_REDIRECT_URI=studioadmin://oauth/callback
# API health is checked in-process; do not point a worker at localhost.
PROVIDER_MONITOR_INTERVAL_MS=300000
PROVIDER_ALERT_COOLDOWN_MS=900000
# Firebase Admin service-account fields used only by the server/worker.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Defaults ---
DEFAULT_TENANT_SLUG=demo
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_DURATION_SECONDS=30

# --- Social distribution (app credentials; user tokens are stored encrypted in DB) ---
# Public URL used for OAuth redirects. Local Vite: leave unset to use APP_URL/api/...
API_PUBLIC_URL=
DISTRIBUTION_OAUTH_CALLBACK_BASE=
# YouTube (falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta Graph (Facebook Pages + Instagram Professional)
META_APP_ID=
META_APP_SECRET=
# X / Twitter OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set to 1 after TikTok app audit to post directly instead of creator inbox
TIKTOK_DIRECT_POST=

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PlanType {
  PAYG
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CreditReason {
  PURCHASE
  SUBSCRIPTION_GRANT
  RUN_RESERVE
  RUN_COMPLETED
  RUN_RELEASE
  CORRECTION
  REFUND
  ADMIN_ADJUST
}

enum PaymentStatus {
  paid
  refunded
  pending
}

enum ApprovalMode {
  manual
  auto
  auto_until_render
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?
  runs      ProjectRun[]
  providers ProviderCredential[]
  audits    AuditLog[]
  series    Series[]
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  role      UserRole @default(USER)
  tenantId  String   @unique
  /// Per-user free video quota. null = use platform freeVideosPerUser; 0 = none; N = N free runs.
  freeVideosLimit Int?
  lastLoginAt DateTime?
  lastLoginIp String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription  Subscription?
  creditEntries CreditLedger[]
  payments      Payment[]
  runs          ProjectRun[]
  loginEvents   UserLoginEvent[]
  mobileAuthCodes MobileAuthCode[]
  mobileRefreshTokens MobileRefreshToken[]
  adminDevices  AdminDevice[]

  @@index([email])
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  lemonSubscriptionId String             @unique
  planType            PlanType           @default(SUBSCRIPTION)
  status              SubscriptionStatus @default(ACTIVE)
  creditsPerPeriod    Int                @default(30)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id           String       @id @default(cuid())
  userId       String
  runId        String?
  delta        Float
  reason       CreditReason
  balanceAfter Float
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  ProjectRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([runId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  lemonOrderId   String        @unique
  amountNis      Float
  planType       PlanType
  creditsGranted Int
  status         PaymentStatus @default(paid)
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum RunStatus {
  DRAFT
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum StageName {
  brief
  script
  audio
  asset
  package_
  render
  series
}

enum StageStatus {
  PENDING
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum ProviderType {
  GEMINI
  LLM
  TTS
  MUSIC
  MEDIA_SEARCH
  VIDEO
  STORAGE
}

enum ArtifactKind {
  brief_input
  brief_output
  script_output
  voice_clip
  voice_clone_sample
  music_track
  scene_video_source
  scene_image_source
  scene_reference_frame
  scene_first_frame
  scene_last_frame
  scene_rendered_clip
  final_video
  series_final_video
  package_manifest
  package_instructions
  package_timeline
  package_gemini_render_plan
  render_profile_snapshot
  gemini_operation
}

enum CostActivityType {
  veo_video
  gemini_tts
  gemini_image
  gemini_text
  gemini_music
  gcs_upload
  gcs_storage
}

enum CostChargedStatus {
  yes
  no
  unknown
}

enum CostBilledUnit {
  veo_seconds
  image_call
  text_call
  tts_call
  music_seconds
  bytes
}

enum ProviderMetricType {
  BALANCE
  QUOTA
  BILLING_HEALTH
  ESTIMATED_SPEND
  SERVICE_HEALTH
}

enum ProviderAlertSeverity {
  WARNING
  CRITICAL
  RECOVERY
}

enum ProviderAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model CostEvent {
  id               String            @id @default(cuid())
  tenantId         String
  runId            String
  stageExecutionId String?
  attempt          Int               @default(1)
  stage            StageName
  activityType     CostActivityType
  sceneId          String?
  model            String?
  startedAt        DateTime          @default(now())
  durationMs       Int?
  billedUnits      Float
  unit             CostBilledUnit
  costUsd          Float
  costNis          Float
  charged          CostChargedStatus @default(yes)
  metadata         Json              @default("{}")

  run ProjectRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@index([tenantId, startedAt])
}

model ProjectRun {
  id             String       @id @default(cuid())
  tenantId       String
  userId         String?
  status         RunStatus    @default(DRAFT)
  currentStage   StageName?
  brief          Json
  approvalMode   ApprovalMode @default(auto)
  isCorrectionRun Boolean     @default(false)
  parentRunId    String?
  creditReserved Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentRun    ProjectRun?    @relation("RunCorrections", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns    ProjectRun[]   @relation("RunCorrections")
  stages       StageExecution[]
  artifacts    Artifact[]
  costEvents   CostEvent[]
  creditEntries CreditLedger[]

  @@index([tenantId, status])
  @@index([userId, status])
}

model StageExecution {
  id          String      @id @default(cuid())
  runId       String
  stage       StageName
  status      StageStatus @default(PENDING)
  attempts    Int         @default(0)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  run ProjectRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@index([status])
}

model Artifact {
  id        String       @id @default(cuid())
  runId     String
  stage     StageName
  kind      ArtifactKind
  gcsPath   String
  mimeType  String
  sizeBytes Int
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())

  run ProjectRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stage])
  @@index([runId, kind])
}

model ProviderCredential {
  id           String       @id @default(cuid())
  tenantId     String
  type         ProviderType
  provider     String
  displayName  String
  enabled      Boolean      @default(true)
  priority     Int          @default(10)
  encryptedKey String?
  config       Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, enabled, priority])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

model MobileAuthCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String    @unique
  deviceId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MobileRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  deviceId   String
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@index([familyId])
  @@index([expiresAt])
}

model AdminDevice {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String
  platform    String    @default("android")
  fcmToken    String?
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([fcmToken])
}

model ProviderMonitor {
  id                  String             @id @default(cuid())
  provider            String             @unique
  displayName         String
  metricType          ProviderMetricType
  unit                String?
  warningThreshold    Float?
  criticalThreshold   Float?
  lastValue           Float?
  lastCheckedAt       DateTime?
  lastHealthyAt       DateTime?
  source              String
  sourceRealtime      Boolean            @default(false)
  billingUrl          String?
  lastErrorCode       String?
  lastErrorMessage    String?
  estimatedRunwayHours Float?
  enabled             Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  snapshots ProviderSnapshot[]
  alerts    ProviderAlert[]

  @@index([enabled, lastCheckedAt])
}

model ProviderSnapshot {
  id                  String   @id @default(cuid())
  monitorId           String
  value               Float?
  healthy             Boolean
  source              String
  sourceRealtime      Boolean  @default(false)
  estimatedRunwayHours Float?
  details             Json     @default("{}")
  errorCode           String?
  errorMessage        String?
  checkedAt           DateTime @default(now())

  monitor ProviderMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

model ProviderAlert {
  id                String                @id @default(cuid())
  monitorId         String
  severity          ProviderAlertSeverity
  status            ProviderAlertStatus   @default(OPEN)
  fingerprint       String
  title             String
  message           String
  recommendedAction String?
  sourceEvent       String
  firstSeenAt       DateTime              @default(now())
  lastSeenAt        DateTime              @default(now())
  acknowledgedAt    DateTime?
  acknowledgedById String?
  resolvedAt        DateTime?
  pushSentAt        DateTime?
  occurrenceCount   Int                   @default(1)
  metadata          Json                  @default("{}")

  monitor ProviderMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([fingerprint])
  @@index([status, severity, lastSeenAt])
  @@index([monitorId, lastSeenAt])
}

model Series {
  id           String   @id @default(cuid())
  tenantId     String
  runIds       String[]
  status       String   @default("DRAFT")
  finalGcsPath String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Singleton platform-wide defaults (models, billing promos).
model PlatformSettings {
  id                   String   @id @default("platform")
  defaultRenderProfile String   @default("omni-multiclip")
  geminiTextModel      String?
  geminiTtsModel       String?
  geminiImageModel     String?
  geminiMusicModel     String?
  geminiVideoModel     String?
  freeVideosPerUser    Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model CreativeField {
  id          String   @id @default(cuid())
  key         String   @unique
  sectionKey  String
  kind        String
  sortOrder   Int
  active      Boolean  @default(true)
  isRequired  Boolean  @default(false)
  isProtected Boolean  @default(false)
  config      Json     @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations CreativeFieldTranslation[]
  options      CreativeOption[]

  @@index([deletedAt, active, sortOrder])
  @@index([sectionKey, sortOrder])
}

model CreativeFieldTranslation {
  fieldId      String
  locale       String
  label        String
  sectionLabel String
  helpText     String?
  placeholder  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  field CreativeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([fieldId, locale])
  @@index([locale])
}

model CreativeOption {
  id        String   @id @default(cuid())
  fieldId   String
  code      String
  value     String
  sortOrder Int
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field        CreativeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  translations CreativeOptionTranslation[]

  @@unique([fieldId, code])
  @@unique([fieldId, value])
  @@index([fieldId, deletedAt, active, sortOrder])
}

model CreativeOptionTranslation {
  optionId  String
  locale    String
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option CreativeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@index([locale])
}


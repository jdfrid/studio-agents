# Copy to infra/hetzner/.env on the Hetzner server:
#   cp infra/hetzner/env.example infra/hetzner/.env

# --- Postgres (internal Docker network) ---
POSTGRES_USER=studio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=studio_agents

# --- Public web port (only web is exposed) ---
HTTP_PORT=80
# Behind Caddy: HTTP_PORT=8080 (user) and ADMIN_HTTP_PORT=8081 (admin SPA)
ADMIN_HTTP_PORT=8081

# --- App secrets ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY_BASE64=

# --- Google Cloud Storage (required for artifacts) ---
GCS_BUCKET=
# Path to service-account JSON on the Hetzner host (recommended — avoids .env quoting issues)
GCS_CREDENTIALS_FILE=/root/gcs-key.json
# Optional inline JSON (leave empty when using GCS_CREDENTIALS_FILE)
GCS_CREDENTIALS_JSON=

# --- Gemini (required for real video pipeline) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_MUSIC_MODEL=lyria-3-clip-preview
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Veo Lite is text-only and often rejects image-to-video — not recommended for studio-agents:
# GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
# Standard (expensive — ~$0.40/sec):
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# --- Cost controls (budget mode defaults) ---
# TARGET_SCENE_SECONDS=10
# GEMINI_VEO_DURATION_BUCKET=4
# ASSET_MODE=reference_only
# ASSET_MODE=shared_reference
# GEMINI_VEO_RESOLUTION=720p
GEMINI_VEO_AUDIO=0
# Keep Veo silent — narration comes from Gemini TTS + FFmpeg mix (native Veo audio often fails).
# GEMINI_VEO_MODE=multiclip   # deprecated alias — prefer RENDER_PROFILE
# RENDER_PROFILE=veo-multiclip   # veo-multiclip | veo-extend | kling-i2v | wan-i2v | hailuo-i2v | heygen-i2v
FAL_API_KEY=   # required when RENDER_PROFILE=kling-i2v / wan-i2v / hailuo-i2v (or selecting fal/kling in UI)
# --- HeyGen (image lip-sync talking head) ---
# Required when RENDER_PROFILE=heygen-i2v or selecting HeyGen in admin/UI.
HEYGEN_API_KEY=
# Optional: used only if scene TTS audio is missing (script + voice_id path).
# HEYGEN_VOICE_ID=
# HEYGEN_API_BASE=https://api.heygen.com

# --- ElevenLabs (optional voice cloning for narration) ---
# When set, users can upload a voice sample on create-video; audio stage clones it and narrates with that voice.
ELEVENLABS_API_KEY=
# RENDER_OUTPUT_SCALE=480
# STUDIO_BUDGET_MODE=0
# USD_TO_ILS=3.6

# GCS_SIGNED_URL_TTL_SECONDS=14400
LOG_LEVEL=info
GEMINI_LYRIA_ENABLED=1
DEFAULT_TENANT_SLUG=demo
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_DURATION_SECONDS=30
GCS_SIGNED_URL_TTL_SECONDS=3600

# --- SaaS Auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
ADMIN_EMAILS=jdfrid@gmail.com
APP_URL=https://prompt2spot.com
ADMIN_URL=https://admin.prompt2spot.com
# Optional: override shared auth cookie domain (default: .prompt2spot.com from APP_URL)
# COOKIE_DOMAIN=.prompt2spot.com
CORS_ORIGINS=https://prompt2spot.com,https://www.prompt2spot.com,https://admin.prompt2spot.com
# AUTH_DISABLED=1   # local dev only

# --- Lemon Squeezy billing ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PAYG=
LEMONSQUEEZY_VARIANT_SUBSCRIPTION=

# Free videos per user without credits — prefer admin UI (Settings). Env is fallback on first boot.
# 0 = no free videos; N = each user gets N free runs before credits are required.
FREE_VIDEOS_PER_USER=0
